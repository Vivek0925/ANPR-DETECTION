# Copy this file to .env and adjust as needed. All values shown are the
# defaults already baked into config.py, so .env is optional for local dev.

# --- Models -----------------------------------------------------------
# Standard COCO-pretrained YOLOv8n, used ONLY for vehicle detection
# (car/motorcycle/bus/truck). Auto-present if you followed the README.
VEHICLE_MODEL_PATH=models/yolov8n.pt

# License-plate-specific YOLOv8 model. The stock COCO model has NO
# "license plate" class -- this MUST be a model fine-tuned for plates.
# See README.md > "AI Model Setup" for where these weights come from
# and how to swap in your own.
PLATE_MODEL_PATH=models/license_plate_detector.pt

OCR_ENGINE=easyocr

# --- Pipeline tuning ----------------------------------------------------
# How many frames PER SECOND OF VIDEO TIME to actually run detection on.
PROCESS_FPS=3

VEHICLE_CONF_THRESHOLD=0.35
PLATE_CONF_THRESHOLD=0.30
OCR_CONF_THRESHOLD=0.25
MIN_PLATE_TEXT_LEN=4

# Sightings of the same plate within this many seconds count as ONE
# appearance (keeps the highest-confidence read).
DEDUP_WINDOW_SECONDS=3.0
